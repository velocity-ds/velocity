<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.velocity</groupId>
    <artifactId>velocity-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>velocity-app</artifactId>
  <properties>
    <spring-boot.run.skip>false</spring-boot.run.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>net.velocity</groupId>
      <artifactId>velocity-browser</artifactId>
    </dependency>
    <!-- Declared before velocity-core so the classpath keeps the monolith order: velocity-slack brings Tyrus, whose bundled
         jakarta.websocket API must win over Tomcat's, as it did before the module split. -->
    <dependency>
      <groupId>net.velocity</groupId>
      <artifactId>velocity-slack</artifactId>
    </dependency>
    <!-- Feature modules declared before velocity-core keep the precedence their classes had when they lived in this
         module's own classes directory, ahead of every library. -->
    <dependency>
      <groupId>net.velocity</groupId>
      <artifactId>velocity-code-execution</artifactId>
    </dependency>
    <dependency>
      <groupId>net.velocity</groupId>
      <artifactId>velocity-platform</artifactId>
    </dependency>
    <dependency>
      <groupId>net.velocity</groupId>
      <artifactId>velocity-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>net.velocity</groupId>
      <artifactId>velocity-web-search</artifactId>
    </dependency>
    <dependency>
      <groupId>net.velocity</groupId>
      <artifactId>velocity-mcp</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- Keeps the executable jar name velocity-0.0.1-SNAPSHOT.jar (now under velocity-modules/velocity-app/target/). -->
    <finalName>velocity-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- The application reads .env, data/, runtime/ and target/frontend/ relative to the repository root. -->
          <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Opt-in: packages the example feature module (docs/adding-a-feature.md). Off by default, so the
           default jar is unchanged. A real feature would be a plain <dependency> above instead. -->
      <id>example-feature</id>
      <dependencies>
        <dependency>
          <groupId>net.velocity</groupId>
          <artifactId>velocity-example-feature</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>frontend</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <configuration>
              <workingDirectory>${maven.multiModuleProjectDirectory}/frontend</workingDirectory>
            </configuration>
            <executions>
              <execution>
                <id>frontend-install</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>generate-resources</phase>
                <configuration>
                  <executable>npm</executable>
                  <arguments>
                    <argument>ci</argument>
                    <argument>--no-fund</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>frontend-build</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>generate-resources</phase>
                <configuration>
                  <executable>npm</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>build</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>frontend-format-check</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>verify</phase>
                <configuration>
                  <executable>npm</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>format:check</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>browser-format-check</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>verify</phase>
                <configuration>
                  <workingDirectory>${maven.multiModuleProjectDirectory}/runtime/browser-use-runtime</workingDirectory>
                  <executable>npm</executable>
                  <arguments>
                    <argument>run</argument>
                    <argument>format:check</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>package-operator-console</id>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <phase>process-classes</phase>
                <configuration>
                  <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${maven.multiModuleProjectDirectory}/target/frontend</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
