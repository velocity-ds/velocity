root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 110

[*.{js,cjs,mjs,jsx,ts,tsx,json,yml,yaml,xml,css,html}]
indent_size = 2

[*.{java,py,js,cjs,mjs,jsx,ts,tsx}]
# Multiline literals can contain meaningful whitespace; use the language formatter.
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
