<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
    <!-- lookup parent from repository -->
  </parent>
  <groupId>net.velocity</groupId>
  <artifactId>velocity-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules>
    <module>velocity-modules/velocity-core</module>
    <module>velocity-modules/velocity-platform</module>
    <module>velocity-modules/velocity-slack</module>
    <module>velocity-modules/velocity-browser</module>
    <module>velocity-modules/velocity-app</module>
    <module>velocity-modules/velocity-code-execution</module>
    <module>velocity-modules/velocity-example-feature</module>
    <module>velocity-modules/velocity-web-search</module>
    <module>velocity-modules/velocity-mcp</module>
  </modules>
  <properties>
    <java.version>25</java.version>
    <!-- Only velocity-app runs; every library module skips spring-boot:run. -->
    <spring-boot.run.skip>true</spring-boot.run.skip>
    <anthropic-java.version>2.62.0</anthropic-java.version>
    <openai-java.version>4.63.3</openai-java.version>
    <slack-java.version>1.51.0</slack-java.version>
    <mcp-java.version>2.0.1</mcp-java.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-slack</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-browser</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-code-execution</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-example-feature</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-web-search</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.velocity</groupId>
        <artifactId>velocity-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- JUnit Jupiter, AssertJ and the Spring test utilities for every module's unit tests (src/test/java). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <encoding>UTF-8</encoding>
          <lineEndings>UNIX</lineEndings>
          <!-- Recheck source when the external Eclipse profile changes, too. -->
          <upToDateChecking>
            <enabled>false</enabled>
          </upToDateChecking>
          <java>
            <eclipse>
              <version>4.37</version>
              <file>${maven.multiModuleProjectDirectory}/config/eclipse-formatter.xml</file>
            </eclipse>
            <importOrder>
              <order>java,javax,org,com,net,,\#</order>
            </importOrder>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <nrOfIndentSpace>2</nrOfIndentSpace>
              <expandEmptyElements>false</expandEmptyElements>
              <sortProperties>false</sortProperties>
              <sortModules>false</sortModules>
              <sortExecutions>false</sortExecutions>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>check-formatting</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
          <includeResources>false</includeResources>
          <!-- Test sources follow the same brace rule as production code. -->
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>14.3.0</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>check-readable-control-flow</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
